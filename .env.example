# --- MVP local (zero infra) ---
STORAGE=memory
CHECKPOINTER=memory
VECTOR_BACKEND=memory
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=1536
API_KEYS=dev-key

DUMP_FIRST=true
ADAPTIVE_PROBES=true
LLM_PROBE=true
VALIDATOR_ENABLED=false
LLM_TIMEOUT_SECONDS=8

# SpaceXAI / xAI (OpenAI-compatible). Empty key → fake tutor templates.
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.6
LLM_API_KEY=
XAI_API_KEY=

# --- Compose (optional) ---
DATABASE_URL=postgresql+asyncpg://vlearn:vlearn@localhost:5432/vlearn
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
CHECKPOINTER_TTL_MINUTES=1440
