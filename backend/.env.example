# Sao chép thành .env (KHÔNG commit .env). Key chỉ nằm ở backend.
# ==============================================================================
# 1. MÔ HÌNH NGÔN NGỮ
# ==============================================================================
# fake | openai | claude | gemini
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_MODEL_EXPLAIN=
LLM_MODEL_JUDGE=
LLM_TIMEOUT=25
LLM_MAX_RETRIES=2

# --- Tốc độ trả lời (xem README §8) ---
USE_JUDGE=1                 # 0 = bỏ hẳn bước LLM chấm: nhanh hơn ~2-3s nhưng mất một lớp kiểm chứng
JUDGE_ONLY_WHEN_NOVEL=1     # chỉ chấm khi câu trả lời có câu tự viết (không nằm trong phần đã duyệt)
SPECULATIVE_EXPLAIN=1       # soạn sẵn bài theo luật, song song lúc LLM chẩn đoán
# Gemini 2.5 mặc định bật "thinking" → chậm. 0 = tắt, -1 = theo mặc định của Google.
GEMINI_THINKING_BUDGET=0

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# 2. TÌM NGUỒN (RAG)
# ==============================================================================
# hybrid (BM25 + vector) | bm25 | dense
RETRIEVAL_MODE=hybrid
HYBRID_ALPHA=0.5
RRF_K=60
RETRIEVAL_MIN_SCORE=1.0
DENSE_TIMEOUT=4             # trần chờ vector search Supabase mỗi câu hỏi (giây)
# Vector: để trống = theo LLM_PROVIDER (Claude không có API embeddings → đặt openai hoặc gemini)
# local = dùng sentence-transformers trên máy (cần requirements.txt đầy đủ; nạp lần đầu ~30s,
# đã được nạp sẵn ở nền lúc khởi động nên câu hỏi đầu tiên không phải chờ).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ==============================================================================
# 3. SUPABASE (hồ sơ, bộ nhớ dài hạn, tài khoản, lecture_chunks)
#    Chạy backend/supabase_schema.sql trong SQL Editor trước khi điền vào đây.
#    Dùng service_role key (chỉ nằm ở backend, không bao giờ đưa ra trình duyệt).
# ==============================================================================
SUPABASE_URL=
SUPABASE_KEY=

# Miền frontend được phép gọi backend khi deploy tách đôi (ngăn cách bằng dấu phẩy).
# localhost và *.vercel.app đã được cho phép sẵn — chỉ cần điền khi dùng tên miền riêng.
ALLOWED_ORIGINS=

# ==============================================================================
# 4. BỘ NHỚ DÀI HẠN — nhịp ghi và mức nén (giữ cho dữ liệu không phình)
# ==============================================================================
MEMORY_FLUSH_EVERY=3        # cứ 3 lượt hỏi thì đẩy bộ nhớ lên Supabase
MEMORY_COMPACT_EVERY=10     # cứ 10 lượt thì nén lại (bỏ cách giải thích cũ / thừa)
MEMORY_MAX_STRATEGIES=6     # mỗi khái niệm nhớ tối đa 6 cách giải thích
MEMORY_MAX_EVENTS=50        # mỗi người học giữ tối đa 50 sự kiện
STALE_DAYS=14               # hồ sơ cũ hơn 14 ngày thì coi là "lâu chưa ôn"
STRATEGY_TTL_DAYS=30        # cách giải thích cũ hơn 30 ngày thì quên

# ==============================================================================
# 5. KHÁC
# ==============================================================================
REPLAY=0
TRACE_TEXT=0
# CHUNKS_PATH=../data/chunks.local.json
# DB_PATH=p3.db
