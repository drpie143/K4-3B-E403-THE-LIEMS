# Sao chép thành .env (KHÔNG commit .env). Key chỉ nằm ở backend.

# fake | openai | claude | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Tuỳ chọn: model riêng cho bước viết giải thích / bước chấm
LLM_MODEL_EXPLAIN=
LLM_MODEL_JUDGE=
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2
USE_JUDGE=1

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# 1 = không gọi LLM, dùng cache/mẫu đã duyệt (demo dự phòng)
REPLAY=0
# 1 = ghi nguyên văn câu hỏi vào traces/ (chỉ bật khi debug trên máy)
TRACE_TEXT=0
RETRIEVAL_MIN_SCORE=1.0
STALE_DAYS=14
STRATEGY_TTL_DAYS=30
# Đường dẫn tuỳ chọn
# CHUNKS_PATH=../data/chunks.local.json
# DB_PATH=p3.db

# Upstash Vector DB (Cloud Vector DB for Hybrid Search)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

