# ==============================================================================
# VLearn Tutor - Backend Environment Variables
# Sao chép file này thành .env (File .env đã được .gitignore chặn, KHÔNG commit).
# ==============================================================================

# --- LLM Provider & Model Settings ---
# Hỗ trợ: openai | gemini | claude | fake
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MODEL_EXPLAIN=gpt-4o-mini
LLM_MODEL_JUDGE=gpt-4o-mini
LLM_TIMEOUT=25
LLM_MAX_RETRIES=2
USE_JUDGE=1

# --- API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=

# --- Retrieval & Hybrid Search Settings ---
# hybrid (BM25 + Vector) | bm25 | dense
RETRIEVAL_MODE=hybrid
HYBRID_ALPHA=0.5
RRF_K=60

# --- Vector Embedding Settings ---
# openai (text-embedding-3-small) | gemini (text-embedding-004)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase Database & Vector Store Settings ---
# Điền thông tin dự án Supabase của bạn tại https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# --- Runtime & Debug Flags ---
REPLAY=0
TRACE_TEXT=0
TRACE_PROMPTS=1
RETRIEVAL_MIN_SCORE=1.0
STALE_DAYS=14
STRATEGY_TTL_DAYS=30

# --- Paths (Mặc định tự động nhận diện) ---
# CHUNKS_PATH=../data/chunks.local.json
# DB_PATH=p3.db
